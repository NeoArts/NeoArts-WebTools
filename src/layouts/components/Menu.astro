---
import { MenuOptions } from "../../shared/ui/constants/Menu";

// Icons for menu items
const menuIcons: Record<string, string> = {
    "Cuentas de cobro": `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`,
    "Creador de cotizaciones": `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
    "Proveedores": `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>`,
    "Notificaciones": `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-3.5-3.5c-.275-.275-.275-.725 0-1L20 9m-5 8v3a2 2 0 01-2 2H9a2 2 0 01-2-2v-3m8 0V9a6 6 0 10-12 0v8m12 0H3m9-13.5a2.5 2.5 0 105 0 2.5 2.5 0 00-5 0z"></path></svg>`,
};

const currentPath = Astro.url.pathname;
---

<nav>
    <ul class="space-y-2">
        {MenuOptions.map((option) => (
            option.active && (
                <li>
                    <a 
                        class={`
                            flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 group
                            ${currentPath === option.href 
                                ? 'bg-purple-50 text-purple-700 border-r-4 border-purple-600' 
                                : 'text-gray-700 hover:bg-gray-50 hover:text-purple-600'
                            }
                        `}
                        href={option.href}
                    >
                        <span class={`
                            transition-colors duration-200
                            ${currentPath === option.href 
                                ? 'text-purple-600' 
                                : 'text-gray-400 group-hover:text-purple-500'
                            }
                        `} set:html={menuIcons[option.title] || ''} />
                        
                        <span class="font-medium text-sm">
                            {option.title}
                        </span>
                        
                        {currentPath === option.href && (
                            <div class="ml-auto w-2 h-2 bg-purple-600 rounded-full"></div>
                        )}
                    </a>
                </li>
            )
        ))}
    </ul>
</nav>