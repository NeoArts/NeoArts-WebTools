---
import { MenuOptions } from "../../shared/ui/constants/Menu";
---

<nav>
    <ul>
        {MenuOptions.map((option) => (
            option.active && (
                <li>
                    <a class="block p-2 cursor-pointer hover:bg-gray-200 rounded-xl" href={option.href}>{option.title}</a>
                </li>
            )
        ))}
    </ul>
</nav>