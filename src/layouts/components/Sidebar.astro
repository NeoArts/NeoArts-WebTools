---
import Menu from "./Menu.astro";
---

<aside class="fixed left-0 top-0 w-80 h-screen bg-white border-r border-gray-200 shadow-sm z-40">
    <!-- Header -->
    <div class="p-6 border-b border-gray-200">
        <div class="flex items-center gap-3">
            <img src={`${import.meta.env.BASE_URL}icons/logo_expanded.svg`} alt="Logo NeoArts" class="h-8" />
            <div class="flex flex-col">
                <span class="text-lg font-semibold text-gray-900">NeoArts</span>
                <span class="text-sm text-gray-500">WebTools</span>
            </div>
        </div>
    </div>
    
    <!-- Navigation -->
    <nav class="p-4 h-[calc(100vh-100px)] overflow-y-auto">
        <Menu />
    </nav>
    
    <!-- Footer -->
    <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200 bg-gray-50">
        <div class="text-xs text-gray-500 text-center">
            <p>© 2025 NeoArts</p>
            <p>Version 2.0</p>
        </div>
    </div>
</aside>