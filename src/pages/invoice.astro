---
import Layout from "../layouts/Layout.astro";
import InvoiceGenerator from "../features/invoice/components/InvoiceGenerator";

export const prerender = false;
---

<Layout title="Cuentas de cobro">
    <div class="space-y-6">
        <!-- Page Header -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-purple-100 rounded-lg">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Generador de cuentas de cobro</h1>
                    <p class="text-gray-600 mt-1">Crea y gestiona las cuentas de cobro para tus clientes</p>
                </div>
            </div>
        </div>

        <!-- Invoice Generator Component -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <InvoiceGenerator client:visible />
        </div>
    </div>
</Layout>
