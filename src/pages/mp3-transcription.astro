---
import Layout from "../layouts/Layout.astro";
import Mp3TranscriptionComponent from "../features/mp3-transcription/components/Mp3Transcription";

export const prerender = false;
---

<Layout title="Transcripción MP3">
    <div class="space-y-6">
        <!-- Page Header -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-blue-100 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 7.464a5 5 0 010 7.072m2.828-2.828a9 9 0 010-12.728M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Transcripción de Audio</h1>
                    <p class="text-gray-600 mt-1">Convierte archivos de audio a texto usando inteligencia artificial</p>
                </div>
            </div>
            
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mt-6">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div class="text-sm">
                        <p class="font-medium text-green-900 mb-1">¿Cómo funciona?</p>
                        <p class="text-green-800">
                            1. Carga un archivo de audio (MP3, WAV, M4A, etc.) <br>
                            2. Nuestro sistema lo procesa usando OpenAI Whisper <br>
                            3. Obtén la transcripción de texto precisa <br>
                            4. Descarga o copia el resultado para usar donde necesites
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Component -->
        <Mp3TranscriptionComponent client:visible />
    </div>
</Layout>
