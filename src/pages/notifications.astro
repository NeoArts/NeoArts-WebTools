---
import Layout from '../layouts/Layout.astro';
import NotificationManager from '../features/notifications/components/NotificationManager.tsx';
---

<Layout title="Notificaciones">
    <div class="space-y-6">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Notificaciones</h1>
                    <p class="text-gray-600 mt-1">Gestiona y revisa todas tus notificaciones</p>
                </div>
            </div>
            
            <NotificationManager client:load />
        </div>
    </div>
</Layout>
