---
import Layout from "../layouts/Layout.astro";
import RequirementAnalysisComponent from "../features/requirement-analysis/components/RequirementAnalysis";

export const prerender = false;
---

<Layout title="Analizar requerimiento">
    <div class="space-y-6">
        <!-- Page Header -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-purple-100 rounded-lg">
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Analizador de requerimientos</h1>
                    <p class="text-gray-600 mt-1">Analiza documentos y extrae historias de usuario para generar prompts inteligentes para GitHub Copilot</p>
                </div>
            </div>
            
        </div>

        <!-- Main Component -->
        <RequirementAnalysisComponent client:visible />
    </div>
</Layout>
